NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# SQLite cria automaticamente o arquivo na pasta data.
# Em hospedagem, configure DATA_DIR para uma pasta/volume persistente.
DATA_DIR=./data

# Troque por uma chave longa e aleatória antes de publicar.
SESSION_SECRET=troque-por-uma-chave-aleatoria-longa

# Primeiro administrador (criado pelo comando npm run db:init)
ADMIN_NAME=Administrador Gira's Beach
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=troque-esta-senha-por-uma-forte

# Mercado Pago: use credenciais de teste durante o desenvolvimento.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
